#version 410 core

// Analytical noise and FBM implementation adapted from:
// Inigo Quilez, "A rainforest landscape" (2016)
// https://iquilezles.org/articles/fbm/
// https://iquilezles.org/articles/morenoise/

/*
 * Slope light implementation Based on: code by Etay Meiri, Copyright 2023.
 * Original code licensed under the GNU General Public License v3.0 (GPL-3.0-or-later).
 * This GLSL version is a translation/adaptation of the original code.
 *
 * Original author: Etay Meiri
 * Original source: https://github.com/emeiri/ogldev
 *
 * This file is distributed under the terms of the GPL v3.0 or later.
 */

layout(quads, fractional_odd_spacing, ccw) in;

// uniform sampler2D heightMap;
uniform mat4 model;
uniform mat4 view;
uniform mat4 projection;

in vec2 TextureCoord[];

out float Height;
out vec2 Tex;
out vec3 FragPos;
out vec3 Normal;
out vec3 Tangent;
out vec3 Bitangent;
out float SlopeLight;

uniform float terrainSize;
uniform float noiseScale;
uniform float heightScale;
uniform float heightOffset;
uniform vec3 lightDir;
uniform int softness;
uniform int delta;
uniform float erosionScale;
float hash1(vec2 p)
{
    p = 50.0 * fract(p * 0.3183099);
    return fract(p.x * p.y * (p.x + p.y));
}

vec3 noised(vec2 x)
{
    vec2 p = floor(x);
    vec2 w = fract(x);

    // quintic interpolation
    vec2 u = w * w * w * (w * (w * 6.0 - 15.0) + 10.0);

    // derivative of quintic interpolation
    vec2 du = 30.0 * w * w * (w * (w - 2.0) + 1.0);

    float a = hash1(p + vec2(0.0, 0.0));
    float b = hash1(p + vec2(1.0, 0.0));
    float c = hash1(p + vec2(0.0, 1.0));
    float d = hash1(p + vec2(1.0, 1.0));

    float k0 = a;
    float k1 = b - a;
    float k2 = c - a;
    float k4 = a - b - c + d;

    float value =
        -1.0 +
        2.0 *
        (
            k0 +
            k1 * u.x +
            k2 * u.y +
            k4 * u.x * u.y
        );


    vec2 derivative =
        2.0 * du *
        vec2(
            k1 + k4 * u.y,
            k2 + k4 * u.x
        );


    return vec3(value, derivative);
}


const mat2 m2 = mat2(
     0.80,  0.60,
    -0.60,  0.80
);

const mat2 m2i = mat2(
     0.80, -0.60,
     0.60,  0.80
);


vec3 fbmd_9(vec2 x)
{
    float f = 1.9;
    float s = 0.55;

    float value = 0.0;
    float amplitude = 0.5;

    vec2 derivative = vec2(0.0);

    mat2 m = mat2(1.0);


    for(int i = 0; i < 9; i++)
    {
        vec3 n = noised(x);
        
        vec2 combinedDerivative = derivative + n.yz;
        float influence = 1.0 / (1.0 + erosionScale * length(combinedDerivative));
        
        // height
        value += amplitude * influence * n.x;
          
        // analytical derivative
        derivative += amplitude * m * n.yz;

        amplitude *= s;

        // next octave
        x = f * m2 * x;

        // derivative transformation
        m = f * m2i * m;
    }


    return vec3(value, derivative);
}


void calculateTBN(vec2 terrainDerivative){
    Normal = normalize(vec3(-terrainDerivative.x, 1.0, -terrainDerivative.y));
    Tangent = normalize(vec3(1.0, terrainDerivative.x, 0.0));
    Bitangent = normalize(vec3(0.0, terrainDerivative.y, 1.0));
  } 


float GetTerrainHeight(vec2 worldXZ)
{
    vec2 noisePos = (worldXZ + terrainSize * 0.5) / noiseScale;

    vec3 e = fbmd_9(noisePos);

    return heightScale * e.x + heightOffset;
}


void main()
{
    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    vec2 t00 = TextureCoord[0];
    vec2 t01 = TextureCoord[1];
    vec2 t10 = TextureCoord[2];
    vec2 t11 = TextureCoord[3];

    vec2 t0 = (t01 - t00) * u + t00;
    vec2 t1 = (t11 - t10) * u + t10;

    vec2 texCoord = (t1 - t0) * v + t0;

    Tex = texCoord;

    vec4 p00 = gl_in[0].gl_Position;
    vec4 p01 = gl_in[1].gl_Position;
    vec4 p10 = gl_in[2].gl_Position;
    vec4 p11 = gl_in[3].gl_Position;

    vec3 uVec = p01.xyz - p00.xyz;
    vec3 vVec = p10.xyz - p00.xyz;

    vec3 quadNormal = normalize(cross(vVec, uVec));
    
    vec4 p0 = (p01 - p00) * u + p00;
    vec4 p1 = (p11 - p10) * u + p10;
    vec4 p = (p1 - p0) * v + p0;
    
    // Slope lighting
    vec3 ReversedLightDir = -lightDir;
    ReversedLightDir.y = 0.0;
    ReversedLightDir = normalize(ReversedLightDir);

    vec3 DirX = vec3(1.0, 0.0, 0.0);
    float dpx = dot(DirX, ReversedLightDir);

    vec3 DirZ = vec3(0.0, 0.0, 1.0);
    float dpz = dot(DirZ, ReversedLightDir);

    float RadianOf45Degrees = cos(radians(45.0));

    int dx0 = 0;
    int dx1 = 0;
    int dz0 = 0;
    int dz1 = 0;

    float factor = 0.0;

    bool InterpolateOnX = false;

    if (dpz >= RadianOf45Degrees)
    {
        dz0 = dz1 = 1;
        InterpolateOnX = true;
    }
    else if (dpz <= -RadianOf45Degrees)
    {
        dz0 = dz1 = -1;
        InterpolateOnX = true;
    }
    else
    {
        if (dpz >= 0.0)
        {
            dz0 = 0;
            dz1 = 1;
        }
        else
        {
            dz0 = 0;
            dz1 = -1;
        }

        factor = 1.0 - abs(dpz) / RadianOf45Degrees;

        if (dpx >= 0.0)
        {
            dx0 = dx1 = 1;
        }
        else
        {
            dx0 = dx1 = -1;
        }
    }

    if (InterpolateOnX)
    {
        if (dpx >= 0.0)
        {
            dx0 = 0;
            dx1 = 1;
        }
        else
        {
            dx0 = 0;
            dx1 = -1;
        }

        factor = 1.0 - abs(dpx) / RadianOf45Degrees;
    }

    Height = GetTerrainHeight(p.xz);

    vec2 Before0 = p.xz + vec2(dx0, dz0) * delta;
    vec2 Before1 = p.xz + vec2(dx1, dz1) * delta;

    bool V0Inside =
        Before0.x >= -terrainSize * 0.5 &&
        Before0.x <   terrainSize * 0.5 &&
        Before0.y >= -terrainSize * 0.5 &&
        Before0.y <   terrainSize * 0.5;

    bool V1Inside =
        Before1.x >= -terrainSize * 0.5 &&
        Before1.x <   terrainSize * 0.5 &&
        Before1.y >= -terrainSize * 0.5 &&
        Before1.y <   terrainSize * 0.5;

    float f = 0.0;
    float min_brightness = 0.1;

    if (V0Inside && V1Inside)
    {
        float HeightBefore0 = GetTerrainHeight(Before0);
        float HeightBefore1 = GetTerrainHeight(Before1);

        float HeightBefore =
            HeightBefore0 * factor +
            (1.0 - factor) * HeightBefore1;

        f = (Height - HeightBefore) / softness;
    }
    else if (V0Inside)
    {
        float HeightBefore = GetTerrainHeight(Before0);

        f = (Height - HeightBefore) / softness;
    }
    else if (V1Inside)
    {
        float HeightBefore = GetTerrainHeight(Before1);

        f = (Height - HeightBefore) / softness;
    }
    else
    {
        f = 1.0;
    }

    SlopeLight = clamp(f, min_brightness, 1.0);

    // Transform p.xz from centered terrain coordinates to positive terrain coordinates.
    // p.xz: [-terrainSize/2, terrainSize/2] -> [0, terrainSize] 
   
    vec2 noisePos = (p.xz + terrainSize * 0.5) / noiseScale;
    
    vec3 e = fbmd_9(noisePos);
    
    // Convert the derivative from noise space to terrain space. normals are dangerous don't play with that!!
    vec2 terrainDerivative = (heightScale / noiseScale) * e.yz;
    
    // Height = heightScale * e.x + heightOffset;

    calculateTBN(terrainDerivative);


    p.xyz += quadNormal * Height;
    FragPos = (model * p).xyz;
    gl_Position = projection * view * model * p;
}

