#version 410 core

// Analytical noise and FBM implementation adapted from:
// Inigo Quilez, "A rainforest landscape" (2016)
// https://iquilezles.org/articles/fbm/
// https://iquilezles.org/articles/morenoise/

layout(quads, fractional_odd_spacing, ccw) in;

// uniform sampler2D heightMap;
uniform mat4 model;
uniform mat4 view;
uniform mat4 projection;

in vec2 TextureCoord[];

out float Height;
out vec2 Tex;
out vec3 FragPos;
out vec3 Normal;
out vec3 Tangent;
out vec3 Bitangent;
out float Shadow;

uniform float terrainSize;
uniform float noiseScale;
uniform float heightScale;
uniform float heightOffset;
uniform vec3 lightDir;
uniform int softness;
uniform int delta;
uniform float erosionScale;
uniform bool shadow;

float hash1(vec2 p)
{
    p = 50.0 * fract(p * 0.3183099);
    return fract(p.x * p.y * (p.x + p.y));
}

vec3 noised(vec2 x)
{
    vec2 p = floor(x);
    vec2 w = fract(x);

    // quintic interpolation
    vec2 u = w * w * w * (w * (w * 6.0 - 15.0) + 10.0);

    // derivative of quintic interpolation
    vec2 du = 30.0 * w * w * (w * (w - 2.0) + 1.0);

    float a = hash1(p + vec2(0.0, 0.0));
    float b = hash1(p + vec2(1.0, 0.0));
    float c = hash1(p + vec2(0.0, 1.0));
    float d = hash1(p + vec2(1.0, 1.0));

    float k0 = a;
    float k1 = b - a;
    float k2 = c - a;
    float k4 = a - b - c + d;

    float value =
        -1.0 +
        2.0 *
        (
            k0 +
            k1 * u.x +
            k2 * u.y +
            k4 * u.x * u.y
        );


    vec2 derivative =
        2.0 * du *
        vec2(
            k1 + k4 * u.y,
            k2 + k4 * u.x
        );


    return vec3(value, derivative);
}


const mat2 m2 = mat2(
     0.80, -0.60,
     0.60,  0.80
);

const mat2 m2i = mat2(
     0.80,  0.60,
    -0.60,  0.80
);


float terrainHeight(vec2 x, int octaves)
{
    float value = 0.0;
    float amplitude = 1.0;

    vec2 d = vec2(0.0);

    for (int i = 0; i < octaves; i++)
    {
        vec3 n = noised(x);

        d += n.yz;

        float influence = 1.0 / (1.0 + erosionScale * dot(d, d));

        value += amplitude * n.x * influence;

        amplitude *= 0.5;
        x = 2.0 * m2 * x;
    }

    return value;
}

float getTerrainHeight(vec2 p, int octaves)
{
    vec2 noisePos = (p + terrainSize * 0.5) / noiseScale;

    float e = terrainHeight(noisePos, octaves);

    return heightScale * e + heightOffset;
}

float getTerrainHeight(vec2 p)
{
  return getTerrainHeight(p, 9);
}

vec3 calcTerrainNormal(vec4 p)
{
    float eps = 0.001;

    float hL = getTerrainHeight(p.xz - vec2(eps, 0.0));
    float hR = getTerrainHeight(p.xz + vec2(eps, 0.0));
    float hD = getTerrainHeight(p.xz - vec2(0.0, eps));
    float hU = getTerrainHeight(p.xz + vec2(0.0, eps));

    return normalize(vec3(
        hL - hR,
        2.0 * eps,
        hD - hU
    ));
}
 

float softShadow(vec3 ro, vec3 rd)
{
    float result = 1.0;

    float t = 0.05;

    for (int i = 0; i < 64; i++)
    {
        vec3 p = ro + rd * t;

        float terrainY = getTerrainHeight(p.xz);

        float h = p.y - terrainY;

        result = min(result, softness * h / t);

        t += max(h, 0.5);

        if (result < 0.001)
            break;

        if (t > 500.0)
            break;
    }

    return clamp(result, 0.0, 1.0);
}


void main()
{
    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    vec2 t00 = TextureCoord[0];
    vec2 t01 = TextureCoord[1];
    vec2 t10 = TextureCoord[2];
    vec2 t11 = TextureCoord[3];

    vec2 t0 = (t01 - t00) * u + t00;
    vec2 t1 = (t11 - t10) * u + t10;

    vec2 texCoord = (t1 - t0) * v + t0;

    Tex = texCoord;

    vec4 p00 = gl_in[0].gl_Position;
    vec4 p01 = gl_in[1].gl_Position;
    vec4 p10 = gl_in[2].gl_Position;
    vec4 p11 = gl_in[3].gl_Position;

    vec3 uVec = p01.xyz - p00.xyz;
    vec3 vVec = p10.xyz - p00.xyz;

    vec3 quadNormal = normalize(cross(vVec, uVec));
    
    vec4 p0 = (p01 - p00) * u + p00;
    vec4 p1 = (p11 - p10) * u + p10;
    vec4 p = (p1 - p0) * v + p0;
    
    Height = getTerrainHeight(p.xz);
    Normal = calcTerrainNormal(p);

    p.xyz += quadNormal * Height;

    vec3 TerrainPos = p.xyz;

    vec3 L = normalize(-lightDir);

    float diffuse =
        max(dot(normalize(Normal), L), 0.0);

    Shadow = 1.0;
    
    if (shadow){ 
        if (diffuse > 0.01)
        {
            Shadow = softShadow(
                TerrainPos + L * 0.5,
                L
            );
        }
    }

    FragPos = (model * p).xyz;
    gl_Position = projection * view * model * p;
}

