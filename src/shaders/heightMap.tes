#version 410 core

layout(quads, fractional_odd_spacing, ccw) in;

uniform sampler2D heightMap;
uniform mat4 model;
uniform mat4 view;
uniform mat4 projection;
uniform vec2 heightMapTexelSize;

in vec2 TextureCoord[];

out float Height;
out vec2 Tex;
out vec3 FragPos;
out vec3 Normal;
out vec3 Tangent;
out vec3 Bitangent;

void calculateTBN(vec2 texCoord, out vec3 tangent, out vec3 bitangent, out vec3 normal)
{
    float heightScale = 300.0;
    vec2 texelSize = 1.0 / vec2(textureSize(heightMap, 0));

    float hL = texture(heightMap, texCoord - vec2(texelSize.x, 0.0)).r * heightScale - 16.0;
    float hR = texture(heightMap, texCoord + vec2(texelSize.x, 0.0)).r * heightScale - 16.0;
    float hD = texture(heightMap, texCoord - vec2(0.0, texelSize.y)).r * heightScale - 16.0;
    float hU = texture(heightMap, texCoord + vec2(0.0, texelSize.y)).r * heightScale - 16.0;

    tangent = normalize(vec3(2.0, hR - hL, 0.0));
    bitangent = normalize(vec3(0.0, hU - hD, 2.0));
    normal = normalize(cross(bitangent, tangent));
}

void main()
{
    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    vec2 t00 = TextureCoord[0];
    vec2 t01 = TextureCoord[1];
    vec2 t10 = TextureCoord[2];
    vec2 t11 = TextureCoord[3];

    vec2 t0 = (t01 - t00) * u + t00;
    vec2 t1 = (t11 - t10) * u + t10;

    vec2 texCoord = (t1 - t0) * v + t0;

    Tex = texCoord;

    Height = texture(heightMap, texCoord).r * 300.0 - 16.0;

    vec4 p00 = gl_in[0].gl_Position;
    vec4 p01 = gl_in[1].gl_Position;
    vec4 p10 = gl_in[2].gl_Position;
    vec4 p11 = gl_in[3].gl_Position;

    vec3 uVec = p01.xyz - p00.xyz;
    vec3 vVec = p10.xyz - p00.xyz;

    vec3 quadNormal = normalize(cross(vVec, uVec));

    calculateTBN(texCoord, Tangent, Bitangent, Normal);

    vec4 p0 = (p01 - p00) * u + p00;
    vec4 p1 = (p11 - p10) * u + p10;
    vec4 p = (p1 - p0) * v + p0;

    p.xyz += quadNormal * Height;
    FragPos = (model * p).xyz; 
    gl_Position = projection * view * model *p;
}

